# Copy to pipeline/.env and fill locally. Never commit live values.

# Select exactly one model provider: azure or openai.
AI_PROVIDER=azure

# Azure OpenAI (required when AI_PROVIDER=azure).
# Use the OpenAI-compatible base URL, normally ending in /openai/v1/.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-students

# OpenAI-compatible service (required when AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Langfuse (required for both providers because prompts are retrieved by ID).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
